        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    %% ==============================\n    %% 1. USERS\n    %% ==============================\n\n    subgraph USERS[\&quot;USERS &amp; STAKEHOLDERS\&quot;]\n        C[\&quot;Citizen\&quot;]\n        V[\&quot;Community Volunteer\&quot;]\n        R[\&quot;Responder / Field Officer\&quot;]\n        A[\&quot;Authority / Disaster Officer\&quot;]\n        AD[\&quot;System Administrator\&quot;]\n    end\n\n\n    %% ==============================\n    %% 2. PRESENTATION\n    %% ==============================\n\n    subgraph UI[\&quot;PRESENTATION LAYER\&quot;]\n        WEB[\&quot;React Web Application\&quot;]\n        MOBILE[\&quot;Mobile-Friendly Interface\&quot;]\n        DASH[\&quot;Authority &amp; Admin Dashboard\&quot;]\n    end\n\n\n    %% ==============================\n    %% 3. APPLICATION\n    %% ==============================\n\n    subgraph APP[\&quot;APPLICATION LAYER — DJANGO\&quot;]\n        API[\&quot;REST API\&quot;]\n\n        AUTH[\&quot;Authentication &amp; RBAC\&quot;]\n\n        INC[\&quot;Incident Management\&quot;]\n        VERIFY[\&quot;Verification &amp; Triage\&quot;]\n        RESPONSE[\&quot;Response &amp; Assignment\&quot;]\n        ALERT[\&quot;Alerts &amp; Notifications\&quot;]\n\n        GIS[\&quot;Location &amp; GIS\&quot;]\n        EVIDENCE[\&quot;Evidence &amp; Attachments\&quot;]\n        ANALYTICS[\&quot;Dashboard &amp; Analytics\&quot;]\n        AUDIT[\&quot;Audit Logging\&quot;]\n    end\n\n\n    %% ==============================\n    %% 4. DATA\n    %% ==============================\n\n    subgraph DATA[\&quot;DATA &amp; STORAGE LAYER\&quot;]\n        DB[(\&quot;Relational Database\&quot;)]\n        FILES[\&quot;Secure Evidence Storage\&quot;]\n        LOGS[(\&quot;Audit Records\&quot;)]\n    end\n\n\n    %% ==============================\n    %% 5. EXTERNAL\n    %% ==============================\n\n    subgraph EXT[\&quot;EXTERNAL SERVICES\&quot;]\n        MAP[\&quot;GIS / Map Service\&quot;]\n        NOTIFY[\&quot;Notification Gateway\&quot;]\n    end\n\n\n    %% ==============================\n    %% MAIN SYSTEM FLOW\n    %% ==============================\n\n    C --&gt; WEB\n    V --&gt; WEB\n    R --&gt; WEB\n\n    A --&gt; DASH\n    AD --&gt; DASH\n\n    WEB --&gt; API\n    MOBILE --&gt; API\n    DASH --&gt; API\n\n\n    %% ==============================\n    %% AUTHENTICATION\n    %% ==============================\n\n    API --&gt; AUTH\n\n\n    %% ==============================\n    %% CORE INCIDENT PIPELINE\n    %% ==============================\n\n    API --&gt; INC\n    INC --&gt; VERIFY\n    VERIFY --&gt; RESPONSE\n    RESPONSE --&gt; ALERT\n\n\n    %% ==============================\n    %% SUPPORTING SERVICES\n    %% ==============================\n\n    API --&gt; GIS\n    API --&gt; EVIDENCE\n    API --&gt; ANALYTICS\n    API --&gt; AUDIT\n\n\n    %% ==============================\n    %% STORAGE\n    %% ==============================\n\n    AUTH --&gt; DB\n    INC --&gt; DB\n    VERIFY --&gt; DB\n    RESPONSE --&gt; DB\n    ALERT --&gt; DB\n    ANALYTICS --&gt; DB\n\n    EVIDENCE --&gt; FILES\n    AUDIT --&gt; LOGS\n\n\n    %% ==============================\n    %% EXTERNAL SERVICES\n    %% ==============================\n\n    GIS --&gt; MAP\n    ALERT --&gt; NOTIFY\n\n\n    %% ==============================\n    %% STYLING\n    %% ==============================\n\n    classDef user fill:#E8F4F8,stroke:#0F766E,stroke-width:2px,color:#0F172A;\n    classDef ui fill:#EFF6FF,stroke:#2563EB,stroke-width:2px,color:#0F172A;\n    classDef api fill:#E0F2FE,stroke:#0284C7,stroke-width:2px,color:#0C4A6E;\n    classDef service fill:#FFFFFF,stroke:#475569,stroke-width:1.5px,color:#0F172A;\n    classDef data fill:#F8FAFC,stroke:#475569,stroke-width:2px,color:#0F172A;\n    classDef ext fill:#FFF7ED,stroke:#EA580C,stroke-width:2px,color:#7C2D12;\n\n    class C,V,R,A,AD user;\n    class WEB,MOBILE,DASH ui;\n    class API api;\n    class AUTH,INC,VERIFY,RESPONSE,ALERT,GIS,EVIDENCE,ANALYTICS,AUDIT service;\n    class DB,FILES,LOGS data;\n    class MAP,NOTIFY ext;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="JiSZ18Fvdyuxvu8DcoQ7-1">
