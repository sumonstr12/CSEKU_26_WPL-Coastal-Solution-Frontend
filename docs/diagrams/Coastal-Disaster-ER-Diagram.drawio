        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    USER }o--|| ROLE : assigned\n    USER ||--o| CITIZEN_PROFILE : has\n    USER ||--o| VOLUNTEER_RESPONDER_PROFILE : has\n\n    USER ||--o{ INCIDENT_REPORT : submits\n    INCIDENT_CATEGORY ||--o{ INCIDENT_REPORT : classifies\n    INCIDENT_REPORT ||--|| INCIDENT_LOCATION : occurs_at\n\n    ADMINISTRATIVE_AREA ||--o{ INCIDENT_LOCATION : contains\n    ADMINISTRATIVE_AREA ||--o{ SHELTER_RESOURCE : contains\n    ADMINISTRATIVE_AREA ||--o{ ALERT : targets\n\n    INCIDENT_REPORT ||--o{ EVIDENCE_ATTACHMENT : includes\n    INCIDENT_REPORT ||--o{ VERIFICATION_RECORD : reviewed_in\n    USER ||--o{ VERIFICATION_RECORD : performs\n\n    INCIDENT_REPORT ||--o{ RESPONSE_ASSIGNMENT : assigned_through\n    USER ||--o{ RESPONSE_ASSIGNMENT : assigned_to\n    RESPONSE_ASSIGNMENT ||--o{ RESPONSE_ACTION : records\n\n    INCIDENT_REPORT ||--o{ ASSISTANCE_REQUEST : requires\n    USER ||--o{ ASSISTANCE_REQUEST : requests\n\n    USER ||--o{ ALERT : issues\n    ALERT ||--o{ NOTIFICATION : generates\n    USER ||--o{ NOTIFICATION : receives\n\n    USER ||--o{ AUDIT_LOG : generates\n\n\n    USER {\n        uuid id PK\n        string name\n        string phone\n        string email\n        string password_hash\n        uuid role_id FK\n        string status\n        datetime created_at\n    }\n\n    ROLE {\n        uuid id PK\n        string name\n        string permissions\n    }\n\n    CITIZEN_PROFILE {\n        uuid id PK\n        uuid user_id FK\n        string national_id\n        string address\n    }\n\n    VOLUNTEER_RESPONDER_PROFILE {\n        uuid id PK\n        uuid user_id FK\n        string organization\n        string skills\n        string availability_status\n    }\n\n    INCIDENT_CATEGORY {\n        uuid id PK\n        string name\n        string description\n        boolean active\n    }\n\n    INCIDENT_REPORT {\n        uuid id PK\n        uuid reported_by FK\n        uuid category_id FK\n        uuid location_id FK\n        string description\n        string severity\n        string priority\n        string status\n        datetime incident_time\n        datetime reported_at\n    }\n\n    INCIDENT_LOCATION {\n        uuid id PK\n        float latitude\n        float longitude\n        uuid admin_area_id FK\n        string address_text\n        boolean gps_available\n    }\n\n    ADMINISTRATIVE_AREA {\n        uuid id PK\n        string name\n        string type\n        uuid parent_area_id FK\n    }\n\n    EVIDENCE_ATTACHMENT {\n        uuid id PK\n        uuid incident_id FK\n        string file_url\n        string file_type\n        int file_size\n        datetime uploaded_at\n    }\n\n    VERIFICATION_RECORD {\n        uuid id PK\n        uuid incident_id FK\n        uuid reviewed_by FK\n        string result\n        string notes\n        datetime reviewed_at\n    }\n\n    RESPONSE_ASSIGNMENT {\n        uuid id PK\n        uuid incident_id FK\n        uuid assigned_to FK\n        string status\n        datetime assigned_at\n    }\n\n    RESPONSE_ACTION {\n        uuid id PK\n        uuid assignment_id FK\n        string action_taken\n        string outcome\n        datetime recorded_at\n    }\n\n    ASSISTANCE_REQUEST {\n        uuid id PK\n        uuid incident_id FK\n        uuid requested_by FK\n        string request_type\n        string description\n        string status\n        datetime requested_at\n    }\n\n    SHELTER_RESOURCE {\n        uuid id PK\n        uuid admin_area_id FK\n        string name\n        string type\n        int capacity\n        string availability_status\n    }\n\n    ALERT {\n        uuid id PK\n        uuid issued_by FK\n        uuid target_area_id FK\n        string alert_type\n        string message\n        string severity\n        datetime issued_at\n    }\n\n    NOTIFICATION {\n        uuid id PK\n        uuid alert_id FK\n        uuid recipient_id FK\n        string channel\n        string status\n        datetime sent_at\n    }\n\n    AUDIT_LOG {\n        uuid id PK\n        uuid actor_id FK\n        string action\n        string entity_type\n        uuid entity_id\n        datetime timestamp\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="sDOVLkyv_GHBlcSS1bf--1">
